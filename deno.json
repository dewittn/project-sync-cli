{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --watch src/cli/index.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run src/cli/index.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-env --allow-run --output prjsync src/cli/index.ts",
    "install": "deno task compile && sudo mv prjsync /usr/local/bin/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@^1.0.8",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.3",
    "@std/fs": "jsr:@std/fs@^1.0.6",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/log": "jsr:@std/log@^0.224.9",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.0.0-rc.7"
  }
}
